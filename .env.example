# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. Share real keys with teammates privately, not in git.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Called the "publishable" key in newer Supabase dashboards.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never use this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key from Google AI Studio (server-only, used for urgency ranking)
GEMINI_API_KEY=
